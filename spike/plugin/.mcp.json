{
  "mcpServers": {
    "asbuilt": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/..",
        "--extra",
        "serve",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/../asbuilt_mcp.py"
      ],
      "env": {
        "ASBUILT_ARM": "${ASBUILT_ARM:-null}",
        "ASBUILT_FIXTURE": "${ASBUILT_FIXTURE:-}"
      }
    }
  }
}
